{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "lib/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/stripe-webhook",
      "dest": "/api/stripe-webhook.js"
    },
    {
      "src": "/api/([a-z-]+)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache",
        "Service-Worker-Allowed": "/"
      },
      "dest": "/public/sw.js"
    },
    {
      "src": "/(.*)\\.webmanifest",
      "headers": {
        "Content-Type": "application/manifest+json",
        "Cache-Control": "no-cache"
      },
      "dest": "/public/$1.webmanifest"
    },
    {
      "src": "/app/?",
      "dest": "/public/app/index.html"
    },
    {
      "src": "/p/([a-z0-9-]+)/?",
      "dest": "/public/p/index.html"
    },
    {
      "src": "/(en|es|ar)/?",
      "dest": "/public/$1/index.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}